---
import LogoButton from '~/components/widgets/LogoButton.astro'
import SearchSwitch from '~/components/widgets/SearchSwitch.astro'
import ThemeSwitch from '~/components/widgets/ThemeSwitch.astro'
import LangSwitch from '~/components/widgets/LangSwitch.astro'
import { stringsFor } from '~/i18n'

/**
 * The header: the name at the left, search, language and theme at the right.
 * The site's pages are in the sidebar (SideNav); below 1024px the sidebar is
 * a sheet that the menu button here opens.
 */
const S = stringsFor(Astro.url.pathname)
---

<header class="site-header print:hidden">
  <div class="flex items-center gap-2 h-full px-4 md:px-6">
    <button
      type="button"
      id="side-nav-button"
      class="ds-icon-button -ml-1.5"
      aria-label={S.menu}
      aria-controls="side-nav"
      aria-expanded="false"
    >
      <span class="menu-open i-ri-menu-line text-lg" aria-hidden="true"></span>
      <span class="menu-close i-ri-close-line text-lg" aria-hidden="true"
      ></span>
    </button>
    <LogoButton />
    <div class="ml-auto flex items-center gap-1.5 md:gap-2">
      <SearchSwitch />
      <LangSwitch />
      <ThemeSwitch />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid var(--c-border);
    background: color-mix(in srgb, var(--ds-background-100) 80%, transparent);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
  }
  #side-nav-button .menu-close,
  #side-nav-button[aria-expanded='true'] .menu-open {
    display: none;
  }
  #side-nav-button[aria-expanded='true'] .menu-close {
    display: inline-block;
  }
  /* the sidebar is always there from 1024px: no button to open it */
  @media (min-width: 1024px) {
    #side-nav-button {
      display: none;
    }
  }
</style>
