---
import stats from '~/data/stats.json'
import { LOCALES, localeOf, STRINGS } from '~/i18n'

const locale = localeOf(Astro.url.pathname)
const S = STRINGS[locale]
const intl = LOCALES[locale].intl
const dayFmt = new Intl.DateTimeFormat(intl, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
})

interface Day {
  date: string
  count: number
  level: number
}

const x = stats.x as { handle: string; followers: number } | null
const github = stats.github as {
  user: string
  total: number
  days: Day[]
} | null

const fmt = new Intl.NumberFormat(intl)

// Lay days out GitHub-style: one column per week, Sunday on top.
const CELL = 11
const GAP = 3
const days: Day[] = github?.days ?? []
const offset = days.length
  ? new Date(days[0].date + 'T00:00:00Z').getUTCDay()
  : 0
const cells = days.map((d, i) => ({
  ...d,
  col: Math.floor((i + offset) / 7),
  row: (i + offset) % 7,
}))
const cols = cells.length ? cells[cells.length - 1].col + 1 : 0
const width = cols * (CELL + GAP) - GAP
const height = 7 * (CELL + GAP) - GAP

// Month labels at the first column that starts in a new month.
const months: { label: string; col: number }[] = []
let lastMonth = -1
for (const c of cells) {
  if (c.row !== 0 && c !== cells[0]) continue
  const m = new Date(c.date + 'T00:00:00Z').getUTCMonth()
  if (m !== lastMonth) {
    months.push({
      label: new Date(c.date + 'T00:00:00Z').toLocaleString(intl, {
        month: 'short',
        timeZone: 'UTC',
      }),
      col: c.col,
    })
    lastMonth = m
  }
}
if (months.length > 1 && months[1].col - months[0].col < 3) months.shift()
if (months.length && cols - months[months.length - 1].col < 3) months.pop()
---

{
  (x || github) && (
    <div class="activity">
      <div class="activity-stats">
        {x && (
          <a
            class="activity-stat"
            href={`https://x.com/${x.handle}`}
            rel="noopener"
          >
            <span class="activity-label">
              <span class="i-ri-twitter-x-fill" aria-hidden="true" />
              {S.followersOnX}
            </span>
            <span class="activity-value">{fmt.format(x.followers)}</span>
          </a>
        )}
        {github && (
          <a
            class="activity-stat"
            href={`https://github.com/${github.user}`}
            rel="noopener"
          >
            <span class="activity-label">
              <span class="i-uil-github-alt" aria-hidden="true" />
              {S.contributionsLastYear}
            </span>
            <span class="activity-value">{fmt.format(github.total)}</span>
          </a>
        )}
      </div>
      {github && cols > 0 && (
        <div class="heatmap-wrap">
          <svg
            class="heatmap"
            viewBox={`0 -16 ${width} ${height + 16}`}
            width={width}
            role="img"
            aria-label={S.contributionsTotal(fmt.format(github.total))}
          >
            {months.map((m) => (
              <text x={m.col * (CELL + GAP)} y={-5} class="heatmap-month">
                {m.label}
              </text>
            ))}
            {cells.map((c) => (
              <rect
                x={c.col * (CELL + GAP)}
                y={c.row * (CELL + GAP)}
                width={CELL}
                height={CELL}
                rx={2}
                class={`lvl-${c.level}`}
              >
                <title>
                  {S.contributionsOn(
                    c.count,
                    dayFmt.format(new Date(`${c.date}T00:00:00Z`))
                  )}
                </title>
              </rect>
            ))}
          </svg>
        </div>
      )}
    </div>
  )
}

<style>
  /* One card: the two numbers as tiles, the year of commits under them */
  .activity {
    border-radius: var(--radius-md);
    box-shadow: var(--ds-shadow-border);
    overflow: hidden;
  }
  .activity-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    border-bottom: 1px solid var(--c-border);
  }
  .activity-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .activity-stat + .activity-stat {
    border-left: 1px solid var(--c-border);
  }
  .activity-stat:hover {
    background: var(--ds-gray-alpha-100);
  }
  .activity-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--ds-gray-900);
    font-size: 0.8125rem;
  }
  .activity-value {
    color: var(--ds-gray-1000);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .heatmap-wrap {
    padding: 1.25rem;
    overflow-x: auto;
  }
  .heatmap {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .heatmap-month {
    font-size: 9px;
    fill: var(--ds-gray-900);
  }
  /* the brand's accent, the dot of samye.li, in five strengths */
  .heatmap rect {
    fill: var(--c-accent);
  }
  .heatmap .lvl-0 {
    fill: var(--ds-gray-alpha-200);
  }
  .heatmap .lvl-1 {
    fill-opacity: 0.3;
  }
  .heatmap .lvl-2 {
    fill-opacity: 0.55;
  }
  .heatmap .lvl-3 {
    fill-opacity: 0.8;
  }
  .heatmap .lvl-4 {
    fill-opacity: 1;
  }
  @media (max-width: 639.98px) {
    .activity-stat + .activity-stat {
      border-left: 0;
      border-top: 1px solid var(--c-border);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .activity-stat {
      transition: none;
    }
  }
</style>
