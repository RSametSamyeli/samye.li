---
import { localeOf } from '~/i18n'

/**
 * A YouTube video that loads nothing from YouTube until it is played: its
 * thumbnail, kept on this site (public/images/music/<id>.webp, cropped to 21:9), with a play
 * button, swapped on click for the player in YouTube's privacy-enhanced mode
 * (youtube-nocookie.com). The page makes no third-party request, and sets
 * no cookie, until the reader chooses to play.
 */
interface Props {
  /** the YouTube video id (youtu.be/<id>); its thumbnail is /images/music/<id>.webp */
  id: string
  /** artist and song */
  title: string
  /** a line under the title: year, or what it is */
  caption?: string
  /** where to start, in seconds */
  start?: number
}

const { id, title, caption, start } = Astro.props
const tr = localeOf(Astro.url.pathname) === 'tr'
const play = tr ? `Oynat: ${title}` : `Play: ${title}`
---

<figure class="video" data-video={id} data-title={title} data-start={start}>
  <button type="button" class="video-poster" aria-label={play}>
    <img
      src={`/images/music/${id}.webp`}
      alt=""
      width="1680"
      height="720"
      loading="lazy"
      decoding="async"
    />
    <span class="video-play" aria-hidden="true"></span>
  </button>
  <figcaption>
    <span class="video-title">{title}</span>
    {caption && <span class="video-caption">{caption}</span>}
  </figcaption>
</figure>

<script>
  // One listener for every video on the page, and after client navigation.
  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest('.video-poster')
    const figure = button?.closest<HTMLElement>('figure[data-video]')
    if (!button || !figure) return
    const iframe = document.createElement('iframe')
    const start = figure.dataset.start ? `&start=${figure.dataset.start}` : ''
    iframe.src = `https://www.youtube-nocookie.com/embed/${figure.dataset.video}?autoplay=1&rel=0${start}`
    iframe.title = figure.dataset.title ?? 'YouTube video'
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
    iframe.allowFullscreen = true
    iframe.referrerPolicy = 'strict-origin-when-cross-origin'
    iframe.className = 'video-frame'
    button.replaceWith(iframe)
    iframe.focus()
  })
</script>

<style>
  .video {
    margin: 0 !important;
  }
  /* cinematic, 21:9: the thumbnail is cropped to it; the player, once
     playing, takes the video's own 16:9 */
  .video-poster {
    aspect-ratio: 21 / 9;
  }
  :global(.video-frame) {
    aspect-ratio: 16 / 9;
  }
  .video-poster,
  :global(.video-frame) {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-md);
    box-shadow: var(--ds-shadow-border);
    background: var(--ds-background-200);
  }
  .video-poster {
    padding: 0;
    cursor: pointer;
  }
  .video-poster img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .video-poster:hover img {
    transform: scale(1.02);
  }
  /* the play button: a round chip of the page's surface, Geist's menu shadow */
  .video-play {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background: var(--ds-background-100);
    box-shadow: var(--ds-shadow-menu);
    transform: translate(-50%, -50%);
    transition: transform 0.15s ease;
  }
  .video-play::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 0.5rem 0 0.5rem 0.8rem;
    border-color: transparent transparent transparent var(--ds-gray-1000);
  }
  .video-poster:hover .video-play,
  .video-poster:focus-visible .video-play {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .video figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin-top: 0.75rem !important;
    color: var(--ds-gray-900);
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .video-title {
    color: var(--ds-gray-1000);
    font-weight: 500;
  }
  @media (prefers-reduced-motion: reduce) {
    .video-poster img,
    .video-play {
      transition: none;
    }
  }
</style>
