---
import { withBasePath } from '~/utils/path'
import { LOCALES, localeOf, STRINGS } from '~/i18n'

const locale = localeOf(Astro.url.pathname)
const home = withBasePath(LOCALES[locale].home)

/* The name a screen reader or voice control hears starts with the words on
   screen (WCAG 2.5.3, label in name). */
---

<a
  class="logo"
  href={home}
  aria-label={`sam@samye.li, ${STRINGS[locale].homeLabel}`}
  aria-current={Astro.url.pathname === home ? 'page' : undefined}
>
  sam<span class="logo-at">@</span>samye.li
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 0.25rem;
    color: var(--ds-gray-1000);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    text-decoration: none;
    user-select: none;
  }
  .logo-at {
    color: var(--c-accent);
  }
</style>
