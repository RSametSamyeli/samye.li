---
import { stringsFor } from '~/i18n'

const S = stringsFor(Astro.url.pathname)
---

<button
  type="button"
  id="theme-switch"
  class="ds-icon-button"
  title={S.toggleTheme}
  role="switch"
  aria-label={S.darkMode}
  aria-checked="false"
>
  <span class="i-ri-sun-line dark:i-ri-moon-line" aria-hidden="true"></span>
</button>

<script>
  /*
   * Dark by default (the inline script in Head.astro sets it before paint);
   * the switch flips it and remembers the choice. No transition: the theme
   * changes at once, as it does on vercel.com.
   */
  const syncTheme = (isDark: boolean, button: HTMLElement | null) => {
    const root = document.documentElement
    root.classList.toggle('dark', isDark)
    button?.setAttribute('aria-checked', String(isDark))
    document
      .querySelector("meta[name='color-scheme']")
      ?.setAttribute('content', isDark ? 'dark light' : 'light dark')
    document
      .querySelector("meta[name='theme-color']")
      ?.setAttribute(
        'content',
        getComputedStyle(root).getPropertyValue('--ds-background-100').trim()
      )
    try {
      localStorage.setItem('site-theme', isDark ? 'dark' : 'light')
    } catch {
      // storage blocked: the choice lasts for this page only
    }
  }

  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('theme-switch')
    button?.setAttribute(
      'aria-checked',
      String(document.documentElement.classList.contains('dark'))
    )
    button?.addEventListener('click', () => {
      syncTheme(!document.documentElement.classList.contains('dark'), button)
    })
  })
</script>
