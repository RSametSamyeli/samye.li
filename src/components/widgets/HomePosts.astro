---
import { getFilteredPosts, getSortedPosts } from '~/utils/data'
import { LOCALES, localeOf, localized } from '~/i18n'
import { withBasePath } from '~/utils/path'
import { HOME_LABELS } from '~/data/home'

/**
 * The latest posts, newest first: title and date on one row. On Turkish
 * pages a post's Turkish title and link when it has one (on lodos.md's
 * Turkish blog), else the English post, marked as English.
 */
interface Props {
  /** how many posts */
  count?: number
}

const { count = 4 } = Astro.props
const locale = localeOf(Astro.url.pathname)
const posts = getSortedPosts(await getFilteredPosts('blog')).slice(0, count)
const date = new Intl.DateTimeFormat(LOCALES[locale].intl, {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
})

const items = posts.map(({ id, data }) => {
  const translated = locale !== 'en' ? data.translations?.[locale] : undefined
  const href =
    translated?.redirect || data.redirect || withBasePath(`/blog/${id}/`)
  return {
    title: translated?.title ?? data.title,
    href,
    external: /^https?:/.test(href),
    lang: locale !== 'en' && !translated ? LOCALES.en.lang : undefined,
    iso: data.pubDate.toISOString(),
    date: date.format(data.pubDate),
  }
})
---

<ul class="posts">
  {
    items.map((p) => (
      <li>
        <a class="post" href={p.href} rel={p.external ? 'noopener' : undefined}>
          <span class="post-title" lang={p.lang}>
            {p.title}
          </span>
          <time class="post-date" datetime={p.iso}>
            {p.date}
          </time>
        </a>
      </li>
    ))
  }
</ul>
<a class="posts-all" href={withBasePath(localized('/blog/', locale))}>
  {HOME_LABELS.allPosts[locale]}
  <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
</a>

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--c-border);
    color: inherit;
    text-decoration: none;
  }
  .posts li:first-child .post {
    padding-top: 0;
  }
  .post-title {
    color: var(--ds-gray-1000);
    font-weight: 500;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }
  .post:hover .post-title {
    text-decoration-color: currentColor;
  }
  .post-date {
    flex: none;
    color: var(--ds-gray-900);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .posts-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    color: var(--ds-gray-900);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .posts-all:hover {
    color: var(--ds-gray-1000);
  }
  @media (max-width: 639.98px) {
    .post {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
