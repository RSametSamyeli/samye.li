---
import { counterpartOf, LOCALES, localeOf, STRINGS } from '~/i18n'
import { withBasePath } from '~/utils/path'

/**
 * The other language: the same page in it when there is one, else its home.
 * Shown as its short name (TR / EN); screen readers and voice control hear
 * that name first, then the language in full (WCAG 2.5.3, label in name).
 */
const here = localeOf(Astro.url.pathname)
const { locale, path } = counterpartOf(Astro.url.pathname)
const target = LOCALES[locale]
---

<a
  class="ds-icon-button text-xs! font-600! tracking-wide"
  href={withBasePath(path)}
  hreflang={target.lang}
  lang={target.lang}
  title={STRINGS[here].switchTo}
  aria-label={`${target.short}, ${STRINGS[here].switchTo}`}
  data-lang-switch
>
  {target.short}
</a>
