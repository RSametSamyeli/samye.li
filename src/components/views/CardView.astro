---
import CardItem from '~/components/views/CardItem.astro'
import Warning from '~/components/base/Warning.astro'
import DesktopAside from '~/components/base/DesktopAside.astro'
import MobileControl from '~/components/base/MobileControl.astro'

import { getFilteredPosts, getSortedPosts } from '~/utils/data'
import { withBasePath } from '~/utils/path'
import { localeOf, pathIn } from '~/i18n'
import { FEATURES } from '~/config'

import type { CardItemData } from '~/components/views/CardItem.astro'

interface Props {
  collectionType: 'shorts'
  gap?: number
  minCardWidth?: number
  maxCardWidth?: number
  pageTag?: boolean
}

const {
  collectionType,
  gap = 16,
  minCardWidth,
  maxCardWidth,
  pageTag = false,
} = Astro.props

const WARNING = `No content available for display.
  Please review and modify <code>CardView.astro</code> as needed.`

/* Tag */
const { tag } = FEATURES
const tagEnabled = Array.isArray(tag) && tag[0] && pageTag
const tags: string[][] = []

/* Cards: newest first, linking within the reader's language */
const locale = localeOf(Astro.url.pathname)
const sorted = getSortedPosts(await getFilteredPosts(collectionType))
const dataForGrid: CardItemData[] = sorted.map((item) => ({
  link:
    item.data.redirect ||
    withBasePath(pathIn(`/${collectionType}/${item.id}/`, locale)),
  text: item.data.title,
  date: item.data.pubDate,
  tags: item.data.tags,
}))

if (tagEnabled) {
  for (const item of sorted) {
    if (item.data.tags.length > 0) tags.push(item.data.tags)
  }
}

const haveTags = tagEnabled && tags.length > 0
const isEmpty = dataForGrid.length === 0
---

{
  isEmpty ? (
    <Warning html={WARNING} />
  ) : (
    <>
      {!haveTags && (
        <div
          class="grid auto-rows-[minmax(12.5rem,1fr)] max-w-[67.125rem] mx-auto fade-in"
          style={{
            '--fade-in-duration': '0.6s',
            'gap': `${gap}px`,
            'grid-template-columns': `repeat(auto-fill, minmax(${minCardWidth ? `${minCardWidth}px` : '220px'}, ${maxCardWidth ? `${maxCardWidth}px` : '1fr'}))`,
          }}
        >
          {dataForGrid.map((item) => (
            <CardItem
              class="min-h-40 lt-md:min-h-0
                [&>*:first-child]:rounded-xl"
              item={item}
            />
          ))}
        </div>
      )}
      {haveTags && (
        <>
          <div class="grid items-start gap-8 grid-cols-[minmax(0,1fr)_var(--toc-w)] lt-xl:(grid-cols-1) max-w-[67.125rem] mx-auto fade-in">
            <div
              class="grid items-stretch auto-rows-[minmax(12.5rem,1fr)]"
              style={{
                '--fade-in-duration': '0.6s',
                'gap': `${gap}px`,
                'grid-template-columns': `repeat(auto-fill, minmax(${minCardWidth ? `${minCardWidth}px` : '180px'}, ${maxCardWidth ? `${maxCardWidth}px` : '1fr'}))`,
              }}
            >
              {dataForGrid.map((item) => (
                <CardItem class="[&>*:first-child]:rounded-xl" item={item} />
              ))}
            </div>
            {tagEnabled && tags.length > 0 && (
              <DesktopAside
                tags={tags}
                inline
                tagStyle="max-height: 54vh"
                tagButtonText="Choose Tags"
              />
            )}
          </div>
          {/* Move out of the fade-in element to avoid layering issues causing the panel to be below the backdrop */}
          {tagEnabled && tags.length > 0 && <MobileControl tags={tags} />}
        </>
      )}
    </>
  )
}
