---
import { getCollection } from 'astro:content'

import Warning from '~/components/base/Warning.astro'
import DesktopAside from '~/components/base/DesktopAside.astro'
import MobileControl from '~/components/base/MobileControl.astro'
import Categorizer from '~/components/base/Categorizer.astro'
import GroupItem from '~/components/views/GroupItem.astro'
import projectsData from '~/content/projects/data.json'
import { FEATURES, UI } from '~/config'
import { STRINGS } from '~/i18n'

import type { CollectionKey } from 'astro:content'
import type { Locale } from '~/i18n'
import type { GroupItemData } from '~/components/views/GroupItem.astro'

interface Props {
  collectionType: CollectionKey
  pageToc?: boolean
  locale?: Locale
}

const { collectionType, pageToc = false, locale = 'en' } = Astro.props
/** a category's name in the page's language */
const categoryName = (key: string) => STRINGS[locale].categories[key] ?? key

const WARNING = `No content available for display.
  Please review and modify <code>GroupView.astro</code> as needed.`

let isEmpty = false
let data: Record<string, GroupItemData[]> = {}

/* Projects */
if (collectionType === 'projects') {
  const projects = await getCollection(collectionType)
  isEmpty = projects.length === 0
  if (isEmpty) return

  // data.json order: the collection loader does not keep it
  const projectOrder = new Map(
    projectsData.map(({ id }, index) => [id, index] as const)
  )
  data = [...projects]
    .sort(
      (a, b) =>
        (projectOrder.get(a.data.id) ?? projects.length) -
        (projectOrder.get(b.data.id) ?? projects.length)
    )
    .map((p) => p.data)
    .reduce((acc: Record<string, GroupItemData[]>, { category, ...rest }) => {
      ;(acc[category] ??= []).push(rest)
      return acc
    }, {})
}

/* Toc */
const { toc } = FEATURES
const tocEnabled = Array.isArray(toc) && toc[0] && pageToc
---

{
  isEmpty ? (
    <Warning html={WARNING} />
  ) : (
    <>
      {tocEnabled && (
        <>
          <DesktopAside anchors={Object.keys(data).map(categoryName)} />
          <MobileControl anchors={Object.keys(data).map(categoryName)} />
        </>
      )}
      {Object.keys(data).map((key, idx) => (
        <section
          class="slide-enter mx-auto text-left"
          style={{
            '--enter-stage': idx,
            'max-width': `calc(350px * ${UI.groupView.maxGroupColumns} + ${UI.groupView.maxGroupColumns - 1} * 0.75rem)`,
          }}
        >
          <Categorizer
            text={categoryName(key)}
            needId={tocEnabled}
            wide={true}
          />
          <GroupItem items={data[key]} {locale} />
        </section>
      ))}
    </>
  )
}
