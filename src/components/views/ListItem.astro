---
import Link from '~/components/base/Link.astro'
import { LOCALES, localeOf, pathIn, STRINGS } from '~/i18n'

import { withBasePath } from '~/utils/path'

interface Props {
  collectionType: string
  idx: number
  postSlug?: string
  title: string
  tags?: string[]
  minutesRead?: number
  date: string | Date
  radio?: boolean
  video?: boolean
  platform?: string
  redirect?: string
  /** the post's language, when it differs from the page's (an English post on /tr/blog/) */
  lang?: string
}

const {
  collectionType,
  idx,
  postSlug,
  title,
  tags,
  minutesRead,
  date,
  video,
  radio,
  platform,
  redirect,
  lang,
} = Astro.props

// dates in the page's language (2 Kas, Nov 2)
const locale = localeOf(Astro.url.pathname)
const intl = LOCALES[locale].intl
const shortDate = new Intl.DateTimeFormat(intl, {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(new Date(date))
---

<div class="slide-enter" style={{ '--enter-stage': idx }} data-tags={tags}>
  <Link
    u-flex={tags && tags.length > 0
      ? '~ col items-start gap-2'
      : '~ items-center lt-md:(col items-start) gap-2'}
    class="op-100! list-row overflow-hidden"
    href={redirect
      ? redirect
      : withBasePath(pathIn(`/${collectionType}/${postSlug}/`, locale))}
    external={redirect ? true : false}
    enableNewTabWarning={redirect ? true : false}
  >
    <Fragment slot="title"
      ><span {lang}>{title}</span>{
        lang && (
          <span class="muted text-xs ml-2 font-mono">{lang.toUpperCase()}</span>
        )
      }</Fragment
    >
    <span slot="end" u-flex="~ gap-2 items-center" class="max-w-full">
      {
        video && (
          <span
            u-i-ri-film-line
            class="flex-none text-[var(--ds-gray-900)] align-middle"
            title="Provided in video"
            aria-label="Provided in video"
          />
        )
      }
      {
        radio && (
          <span
            u-i-ri-radio-line
            class="flex-none text-[var(--ds-gray-900)] align-middle"
            title="Provided in radio"
            aria-label="Provided in radio"
          />
        )
      }
      <time
        class="muted text-sm ws-nowrap"
        datetime={new Date(date).toISOString()}
      >
        {shortDate}
      </time>
      {
        !!minutesRead && (
          <span class="muted text-sm ws-nowrap">
            · {minutesRead} {STRINGS[locale].minutes}
          </span>
        )
      }
      {platform && <span class="muted text-sm ws-nowrap">· {platform}</span>}
      {
        tags && tags.length > 0 && (
          <>
            <span class="muted text-sm">· </span>
            <span class="muted text-sm ws-nowrap inner-x-scroll">
              {tags.join(' / ')}
            </span>
          </>
        )
      }
    </span>
  </Link>
</div>

<style>
  /* A row of the list, as on vercel.com/blog: the title, then the date and
     what the post is about, ruled off from the next. */
  .list-row {
    padding-block: 1rem;
    border-bottom: 1px solid var(--c-border);
    color: inherit;
    text-decoration: none;
  }
  .list-row :global(.list-title) {
    color: var(--ds-gray-1000);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5rem;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color 0.15s ease;
  }
  .list-row:hover :global(.list-title) {
    text-decoration-color: currentColor;
  }
</style>
