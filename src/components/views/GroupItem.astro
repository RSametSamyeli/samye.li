---
import Link from '~/components/base/Link.astro'
import { UI } from '~/config'

export interface GroupItemData {
  id: string
  link: string
  desc: string
  icon: string
}

interface Props {
  items: GroupItemData[]
}

const { items } = Astro.props
const { showGroupItemColorOnHover } = UI.groupView
---

<div
  class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-3 pt-3 pb-10"
>
  {
    items.map((item) => (
      <Link
        class={`op-100! group relative flex items-center
          px-3.5 pt-2 pb-3.5 rounded-md
          bg-transparent hover:bg-[#88888811]
          text-4.4 transition-all duration-300`}
        href={item.link}
        external={/^https?:/.test(item.link)}
      >
        <div class="flex-none pt-2 pr-5" aria-hidden="true">
          {item.icon.startsWith('i-') ? (
            <div
              class={`group-hover:data-[show-color]:saturate-100 op-50 saturate-0 leading-9 text-7.5 ${item.icon}`}
              data-show-color={showGroupItemColorOnHover ? '' : undefined}
            />
          ) : (
            <img
              class="block flex-none w-7.5 h-7.5 rounded-md ring-1 ring-[#8883] op-80 group-hover:op-100 transition-opacity"
              src={item.icon}
              alt=""
              width="30"
              height="30"
              decoding="async"
            />
          )}
        </div>
        <div class="flex-auto">
          <div>{item.id}</div>
          <div class="muted text-sm font-normal">{item.desc}</div>
        </div>
      </Link>
    ))
  }
</div>
