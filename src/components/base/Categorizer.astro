---
import { slug } from '~/utils/toc'

interface Props {
  text: string
  needId?: boolean
  wide?: boolean
}

const { text, needId = false, wide = false } = Astro.props
---

{
  wide ? (
    <h2
      {...(needId ? { id: slug(text) } : {})}
      class="toc-heading m-0 pb-3 border-b border-[var(--c-border)] text-sm font-500 text-[var(--ds-gray-900)]"
    >
      {text}
    </h2>
  ) : (
    <h2
      {...(needId ? { id: slug(text) } : {})}
      class="toc-heading not-first:mt-10 mb-1 pb-2 border-b border-[var(--c-border)] font-mono text-sm font-400 text-[var(--ds-gray-900)]"
    >
      {text}
    </h2>
  )
}
