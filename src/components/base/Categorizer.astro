---
import { slug } from '~/utils/toc'

interface Props {
  idx?: number
  text: string
  needId?: boolean
  wide?: boolean
}

const { idx, text, needId = false, wide = false } = Astro.props
---

{
  wide ? (
    <h2
      {...(needId ? { id: slug(text) } : {})}
      class="toc-heading m-0 px-3.5 pb-2 border-b border-[#8883] text-sm font-600 uppercase tracking-[0.12em] muted"
    >
      {text}
    </h2>
  ) : (
    <div
      {...(needId ? { id: slug(text) } : {})}
      class:list={[
        'toc-heading relative h-20 pointer-events-none select-none',
        { 'slide-enter': idx !== undefined },
      ]}
      style={idx !== undefined ? { '--enter-stage': idx - 2 } : undefined}
    >
      <span class="absolute left--12 top--8 op-10 text-8em text-stroke-2 text-stroke-#aaa font-800 color-transparent">
        {text}
      </span>
    </div>
  )
}
