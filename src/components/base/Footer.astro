---
import Link from '~/components/base/Link.astro'
import { SITE } from '~/config'
import { withBasePath } from '~/utils/path'

const year = new Date().getFullYear()

/** Where the site can be read other than as pages: its feed, its source, and its summary for LLMs. */
const links = [
  { href: withBasePath('/rss.xml'), text: 'RSS' },
  { href: withBasePath('/llms.txt'), text: 'llms.txt' },
  { href: 'https://github.com/RSametSamyeli/samye.li', text: 'Source' },
]
---

<footer class="slide-enter animate-delay-1600! px-7 mt-auto mb-8">
  <div
    class="prose mx-auto flex lt-sm:flex-col items-center justify-between gap-2 text-sm muted"
  >
    <span>© {year} {SITE.author}</span>
    <nav aria-label="Elsewhere" class="flex items-center gap-4">
      {
        links.map(({ href, text }) => (
          <Link
            class="op-100! muted! no-underline! hover:underline!"
            href={href}
            external={href.startsWith('http')}
          >
            {text}
          </Link>
        ))
      }
    </nav>
  </div>
</footer>
