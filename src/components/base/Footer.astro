---
import { SITE } from '~/config'
import { localeOf, localized, STRINGS } from '~/i18n'
import { withBasePath } from '~/utils/path'

const locale = localeOf(Astro.url.pathname)
const S = STRINGS[locale]
const year = new Date().getFullYear()

/**
 * The site's "slash pages", in the page's language: in the sidebar too, but
 * the sidebar is behind a button on small screens, and a footer is where
 * readers look for them.
 */
const pages = (
  [
    'now',
    'beliefs',
    'uses',
    'community',
    'outdoors',
    'music',
    'reading',
    'colophon',
  ] as const
).map((key) => ({
  href: withBasePath(localized(`/${key}/`, locale)),
  text: S[key],
}))

/** Where the site can be read other than as pages: its feed, its summary for LLMs, and its source. */
const elsewhere = [
  { href: withBasePath('/rss.xml'), text: 'RSS' },
  { href: withBasePath('/llms.txt'), text: 'llms.txt' },
  { href: 'https://github.com/RSametSamyeli/samye.li', text: S.source },
]
---

<footer class="site-footer print:hidden">
  <div class="site-footer-inner">
    <nav aria-label={S.pages} class="site-footer-links">
      {
        pages.map(({ href, text }) => (
          <a
            href={href}
            aria-current={Astro.url.pathname === href ? 'page' : undefined}
          >
            {text}
          </a>
        ))
      }
    </nav>
    <div class="site-footer-bottom">
      <span>© {year} {SITE.author}</span>
      <nav aria-label={S.elsewhere} class="site-footer-links">
        {
          elsewhere.map(({ href, text }) => (
            <a
              href={href}
              rel={href.startsWith('http') ? 'noopener' : undefined}
            >
              {text}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2rem 2.5rem;
    border-top: 1px solid var(--c-border);
    color: var(--ds-gray-900);
    font-size: 0.875rem;
  }

  .site-footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
    margin: 0 auto;
  }

  @media (min-width: 1280px) {
    :global(.site-main:has(#desktop-aside:not([data-inline]))) .site-footer {
      padding-right: calc(var(--toc-w) + 4rem);
    }
  }

  .site-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  .site-footer a {
    color: var(--ds-gray-900);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer a:hover,
  .site-footer a[aria-current] {
    color: var(--ds-gray-1000);
  }

  .site-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
  }

  @media (max-width: 767.98px) {
    .site-footer {
      padding: 2rem 1.25rem;
    }
  }
</style>
