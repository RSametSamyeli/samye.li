---
import { Font } from 'astro:assets'
import { ClientRouter } from 'astro:transitions'

import {
  getOgImageConfig,
  resolveOgImagePathname,
} from '~/utils/og-image/routing'
import { silentLogger } from '~/utils/server'
import { withBasePath } from '~/utils/path'
import { COLLECTION_LABELS, SITE, UI } from '~/config'
import { alternatesOf, englishPath, LOCALES, localeOf, STRINGS } from '~/i18n'
import { markdownMirrorPath } from '~/utils/ai'

interface Props {
  title?: string
  description?: string
  ogImage?: string | boolean
  pubDate?: string
  lastModDate?: string
  tags?: string[]
  noindex?: boolean
}

const { title, description, ogImage, pubDate, lastModDate, tags, noindex } =
  Astro.props

const X_HANDLE = SITE.xHandle
const locale = localeOf(Astro.url.pathname)
const S = STRINGS[locale]
const lang = LOCALES[locale].lang
// The same page in every language it exists in (hreflang), x-default English.
const alternates = alternatesOf(Astro.url.pathname)?.map((a) => ({
  ...a,
  href: new URL(a.path, SITE.website).href,
}))
const isHome = englishPath(Astro.url.pathname) === '/'
// The home page leads with the name and what he does, which is what a search
// on the name should show. Every other page is "Page · Samet Samyeli".
const pageTitle = isHome
  ? `${SITE.title} · ${S.tagline}`
  : title && title !== SITE.title
    ? `${title} · ${SITE.title}`
    : SITE.title
const pageDescription = description || S.description

const siteName = new URL(SITE.website).hostname
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageConfig = getOgImageConfig()
const ogImagePathname = ogImageConfig
  ? resolveOgImagePathname({
      ogImage,
      title,
      authorOrBrand: ogImageConfig.authorOrBrand,
      pathname: Astro.url.pathname,
      logger: Astro.logger ?? silentLogger,
    })
  : undefined
const ogImageURL = ogImagePathname
  ? new URL(withBasePath(ogImagePathname), Astro.url).href
  : undefined

const markdownMirror = markdownMirrorPath(Astro.url.pathname)

// Structured data for search and answer engines: one linked graph per page.
// The person and the website are the same nodes everywhere (by @id); the home
// page is a ProfilePage about the person, a post a BlogPosting by them.
// https://developers.google.com/search/docs/appearance/structured-data/profile-page
const PERSON_ID = new URL('/#person', SITE.website).href
const WEBSITE_ID = new URL('/#website', SITE.website).href
const pageId = `${canonicalURL.href}#webpage`

const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  'name': SITE.author,
  'alternateName': 'Rüzgar Samet Samyeli',
  'url': SITE.website,
  'jobTitle': S.jobTitle,
  'description': S.description,
  'email': 'mailto:sam@samye.li',
  'image': {
    '@type': 'ImageObject',
    '@id': new URL('/#portrait', SITE.website).href,
    'url': new URL('/images/samet-samyeli.jpg', SITE.website).href,
    'width': 800,
    'height': 800,
    'caption': SITE.author,
  },
  'homeLocation': { '@type': 'Place', 'name': 'Istanbul, Türkiye' },
  'founder': [
    { '@type': 'Organization', 'name': 'lodos.md', 'url': 'https://lodos.md/' },
    { '@type': 'Organization', 'name': 'gazla.co', 'url': 'https://gazla.co/' },
  ],
  'alumniOf': {
    '@type': 'CollegeOrUniversity',
    'name': 'Süleyman Demirel University',
  },
  'knowsAbout': [
    'Software architecture',
    'Application security',
    'Artificial intelligence',
    'TypeScript',
    'Python',
    'PostgreSQL',
  ],
  'sameAs': UI.socialLinks
    .map((l) => l.link)
    .filter((link) => link.startsWith('http')),
}

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  'url': SITE.website,
  'name': siteName,
  'description': S.description,
  'inLanguage': Object.values(LOCALES).map((l) => l.lang),
  'publisher': { '@id': PERSON_ID },
}

const page = pubDate
  ? {
      '@type': 'BlogPosting',
      '@id': pageId,
      'url': canonicalURL.href,
      'mainEntityOfPage': canonicalURL.href,
      'headline': title || SITE.title,
      ...(description && { description }),
      ...(ogImageURL && { image: ogImageURL }),
      'datePublished': pubDate,
      'dateModified': lastModDate || pubDate,
      ...(tags?.length && { keywords: tags }),
      'inLanguage': lang,
      'author': { '@id': PERSON_ID },
      'publisher': { '@id': PERSON_ID },
      'isPartOf': { '@id': WEBSITE_ID },
      'breadcrumb': { '@id': `${canonicalURL.href}#breadcrumb` },
    }
  : {
      '@type': isHome ? 'ProfilePage' : 'WebPage',
      '@id': pageId,
      'url': canonicalURL.href,
      'name': pageTitle,
      'description': pageDescription,
      ...(ogImageURL && { image: ogImageURL }),
      'inLanguage': lang,
      'isPartOf': { '@id': WEBSITE_ID },
      ...(lastModDate && { dateModified: lastModDate }),
      ...(isHome
        ? { mainEntity: { '@id': PERSON_ID } }
        : {
            about: { '@id': PERSON_ID },
            breadcrumb: { '@id': `${canonicalURL.href}#breadcrumb` },
          }),
    }

// Where the page sits: Home > Blog > Post. Sections are named as in the
// navigation; the last crumb is the page itself.
// In Turkish the trail starts at /tr/.
const SECTION_NAMES: Record<string, string> = {
  blog: COLLECTION_LABELS.blog,
  shorts: COLLECTION_LABELS.shorts,
  projects: S.projects,
  lodos: 'lodos.md',
}
const home = LOCALES[locale].home
const segments = englishPath(Astro.url.pathname).split('/').filter(Boolean)
const crumbs = [
  { name: SITE.title, url: new URL(home, SITE.website).href },
  ...segments.map((segment, i) => ({
    name:
      i === segments.length - 1
        ? title || SECTION_NAMES[segment] || segment
        : SECTION_NAMES[segment] || segment,
    url: new URL(`${home}${segments.slice(0, i + 1).join('/')}/`, SITE.website)
      .href,
  })),
]
const breadcrumb =
  crumbs.length > 1
    ? {
        '@type': 'BreadcrumbList',
        '@id': `${canonicalURL.href}#breadcrumb`,
        'itemListElement': crumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          'position': i + 1,
          'name': crumb.name,
          'item': crumb.url,
        })),
      }
    : undefined

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [person, website, page, ...(breadcrumb ? [breadcrumb] : [])],
}
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<!-- Font -->
<Font cssVariable="--font-sans" preload />
<Font cssVariable="--font-mono" />
<Font cssVariable="--font-condensed" />

<!-- Primary Metadata -->
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="author" content={SITE.author} />

<!-- Color -->
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#050505" />
<!-- Initialize as inline scripts for faster response, avoiding FOUC  -->
<script is:inline data-astro-rerun>
  ;(() => {
    // Dark by default; only an explicit toggle by the visitor switches to light.
    const storedTheme = localStorage.getItem('site-theme')
    const theme = storedTheme === 'light' ? 'light' : 'dark'
    const themeColor = theme === 'dark' ? '#050505' : '#fff'

    if (theme === 'dark') {
      document.documentElement.classList.add('dark')
    } else {
      document.documentElement.classList.remove('dark')
    }

    const colorScheme = document.querySelector("meta[name='color-scheme']")
    colorScheme?.setAttribute(
      'content',
      theme === 'dark' ? 'dark light' : 'light dark'
    )

    const themeColorMeta = document.querySelector("meta[name='theme-color']")
    themeColorMeta?.setAttribute('content', themeColor)
  })()
</script>

<!-- Open Graph & Facebook -->
<meta property="og:type" content={pubDate ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
{ogImageURL && <meta property="og:image" content={ogImageURL} />}
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={LOCALES[locale].ogLocale} />
{
  alternates
    ?.filter((a) => a.locale !== locale)
    .map((a) => (
      <meta
        property="og:locale:alternate"
        content={LOCALES[a.locale].ogLocale}
      />
    ))
}
{
  pubDate && (
    <>
      <meta property="article:author" content={SITE.author} />
      <meta property="article:published_time" content={pubDate} />
      {lastModDate && (
        <meta property="article:modified_time" content={lastModDate} />
      )}
      {tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={X_HANDLE} />
<meta name="twitter:creator" content={X_HANDLE} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{ogImageURL && <meta name="twitter:image" content={ogImageURL} />}
{ogImageURL && <meta property="og:image:width" content="1200" />}
{ogImageURL && <meta property="og:image:height" content="630" />}
{ogImageURL && <meta property="og:image:alt" content={pageTitle} />}

<!-- The author's profiles, as the same person (rel=me) -->
{
  UI.socialLinks
    .filter(({ link }) => link.startsWith('http'))
    .map(({ link }) => <link rel="me" href={link} />)
}

<!-- This page in other languages -->
{
  alternates && (
    <>
      {alternates.map((a) => (
        <link rel="alternate" hreflang={LOCALES[a.locale].lang} href={a.href} />
      ))}
      <link
        rel="alternate"
        hreflang="x-default"
        href={alternates.find((a) => a.locale === 'en')?.href}
      />
    </>
  )
}

<!-- Canonical URL -->
{
  noindex ? (
    <meta name="robots" content="noindex, follow" />
  ) : (
    <>
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1"
      />
      <link rel="canonical" href={canonicalURL} />
    </>
  )
}

<!-- Icon -->
<link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
<link rel="icon" sizes="32x32" href={withBasePath('/favicon.ico')} />
<link rel="apple-touch-icon" href={withBasePath('/apple-touch-icon.png')} />

<!-- Manifest -->
<link rel="manifest" href={withBasePath('/app.webmanifest')} />

<!-- Sitemap -->
<link rel="sitemap" href={withBasePath('/sitemap-index.xml')} />

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.title} · Blog`}
  href={withBasePath('/rss.xml')}
/>

<!-- Plain-markdown mirror of this page, and the site summary for LLMs -->
{
  markdownMirror && (
    <link
      rel="alternate"
      type="text/markdown"
      href={withBasePath(markdownMirror)}
    />
  )
}
<link
  rel="alternate"
  type="text/plain"
  title="llms.txt"
  href={withBasePath('/llms.txt')}
/>

<!-- Structured data -->
<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify(structuredData)}
/>

<!-- Router -->
<ClientRouter />
