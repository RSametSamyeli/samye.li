---
interface Props {
  tag: string
  relations?: Record<string, string[]>
  interactive?: boolean
}

const { tag, relations, interactive = false } = Astro.props

const Container = interactive ? 'button' : 'span'
---

<Container
  type={interactive ? 'button' : undefined}
  role={interactive ? 'option' : undefined}
  class="ds-tag"
  aria-selected={interactive ? 'false' : undefined}
  data-active={interactive ? undefined : 'false'}
  data-tag={tag}
  data-related={relations?.[tag]}
>
  {tag}
</Container>

<style>
  /* Geist's pill: a hairline chip, filled when chosen */
  .ds-tag {
    display: inline-flex;
    align-items: center;
    height: 1.5rem;
    padding: 0 0.5rem;
    border-radius: 9999px;
    box-shadow: var(--ds-shadow-border);
    color: var(--ds-gray-900);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  button.ds-tag {
    cursor: pointer;
  }
  button.ds-tag:hover:not(:disabled),
  .ds-tag[data-active='true'] {
    color: var(--ds-gray-1000);
  }
  .ds-tag[aria-selected='true'] {
    background: var(--ds-gray-1000);
    color: var(--ds-background-100);
    box-shadow: none;
  }
  .ds-tag:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
