---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import { LOCALES, localeOf, STRINGS } from '~/i18n'

interface Props {
  title?: string
  subtitle?: string
  isCentered?: boolean
  isSearchable?: boolean
  searchFilter?: string
  class?: string
  /** extra classes on the article (the page's prose) */
  articleClass?: string
  /** a portrait beside the title (the home page) */
  avatar?: { src: ImageMetadata; alt: string }
  /** when the page last changed (ISO date): shown as "Last updated" */
  updated?: string
}

const {
  title,
  subtitle,
  isCentered = false,
  isSearchable,
  searchFilter,
  class: className,
  articleClass,
  avatar,
  updated,
} = Astro.props

const locale = localeOf(Astro.url.pathname)
const updatedText =
  updated &&
  STRINGS[locale].lastUpdated(
    new Intl.DateTimeFormat(LOCALES[locale].intl, {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(updated))
  )
---

<header
  class:list={{
    'prose mx-auto mb-8': true,
    'text-center': isCentered,
  }}
>
  {
    avatar ? (
      <div class="flex items-center gap-5 lt-sm:gap-4">
        <Image
          class="block flex-none m-0! w-22 h-22 lt-sm:(w-18 h-18) rounded-full! object-cover ring-1 ring-[#8884]"
          src={avatar.src}
          alt={avatar.alt}
          widths={[88, 176, 264]}
          sizes="88px"
          width={88}
          height={88}
          loading="eager"
          fetchpriority="high"
        />
        <div class="min-w-0">
          {title && <h1 class="mb-2!">{title}</h1>}
          {subtitle && <p class="m-0! muted italic">{subtitle}</p>}
        </div>
      </div>
    ) : (
      <>
        {title && <h1>{title}</h1>}
        {subtitle && <p class="mt--4! muted italic">{subtitle}</p>}
        {updatedText && (
          <p class="mt--2! text-sm muted">
            <time datetime={updated}>{updatedText}</time>
          </p>
        )}
      </>
    )
  }
  <slot name="head" />
</header>
{
  Astro.slots.has('article') && (
    <article
      class:list={['slide-enter-content prose mx-auto', articleClass]}
      data-pagefind-body={isSearchable ? '' : undefined}
      data-pagefind-filter={
        isSearchable && searchFilter ? searchFilter : undefined
      }
    >
      <slot name="article" />
    </article>
  )
}
{
  Astro.slots.has('default') && (
    <div class:list={['mx-auto', className]}>
      <slot />
    </div>
  )
}
