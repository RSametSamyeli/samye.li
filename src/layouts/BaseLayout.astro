---
import '~/styles/main.css'
import '~/styles/layout.css'
import '~/styles/prose.css'
import '~/styles/markdown.css'

import Head from '~/components/base/Head.astro'
import NavBar from '~/components/nav/NavBar.astro'
import SideNav from '~/components/nav/SideNav.astro'
import BackLink from '~/components/widgets/BackLink.astro'
import Footer from '~/components/base/Footer.astro'
import ToTopButton from '~/components/widgets/ToTopButton.astro'
import Backdrop from '~/components/base/Backdrop.astro'

import { UI, FEATURES } from '~/config'
import { withBasePath } from '~/utils/path'
import { LOCALES, localeOf, STRINGS } from '~/i18n'

interface Props {
  title?: string
  description?: string
  ogImage?: string | boolean
  pubDate?: string
  lastModDate?: string
  tags?: string[]
  /** keep this page out of search results (the 404 page) */
  noindex?: boolean
  /** extra JSON-LD nodes for this page's graph (a reading list) */
  schema?: Record<string, unknown>[]
}

const {
  title,
  description,
  ogImage,
  pubDate,
  lastModDate,
  tags,
  noindex,
  schema,
} = Astro.props
const locale = localeOf(Astro.url.pathname)
/** a home page, in any language: no back link or share row there */
const isHome = Object.values(LOCALES).some(
  (l) => Astro.url.pathname === withBasePath(l.home)
)

let style: Record<string, string> = {}

const { slideEnterAnim } = FEATURES
const enableSlideEnterAnim = Array.isArray(slideEnterAnim) && slideEnterAnim[0]
if (enableSlideEnterAnim)
  style['--enter-step'] = `${slideEnterAnim[1].enterStep}ms`

const {
  externalLink: { newTab, cursorType },
} = UI
const hasCustomCursor =
  newTab && cursorType.length > 0 && cursorType !== 'pointer'
if (hasCustomCursor) style['--external-link-cursor'] = cursorType
---

<!doctype html>
<html lang={LOCALES[locale].lang}>
  <head>
    <Head
      {title}
      {description}
      {ogImage}
      {pubDate}
      {lastModDate}
      {tags}
      {noindex}
      {schema}
    />
  </head>

  <body
    class="min-h-screen font-sans"
    style={Object.keys(style).length !== 0 ? style : undefined}
    data-no-sliding={enableSlideEnterAnim ? undefined : ''}
  >
    <!-- Cloudflare email obfuscation breaks on client-side navigation, so opt out. -->
    <!--email_off-->

    <a class="skip-link" href="#main">{STRINGS[locale].skipToContent}</a>

    <NavBar />

    <div class="site-shell">
      <SideNav />
      <div class="site-main">
        <main id="main">
          <slot />
          {
            !isHome && (
              <footer class="max-w-[42rem] mx-auto mt-16 pt-6 border-t border-[var(--c-border)] flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-sm print:hidden">
                <BackLink />
                <slot name="share" />
              </footer>
            )
          }
        </main>
        <Footer />
      </div>
    </div>
    <ToTopButton />
    <!--/email_off-->

    <!-- Panel Backdrop (on mobile) -->
    <Backdrop />

    <!-- Progress Bar -->
    <script>
      import nprogress from 'nprogress'

      document.addEventListener('astro:before-preparation', () => {
        nprogress.start()
      })

      document.addEventListener('astro:page-load', () => {
        nprogress.done()
      })
    </script>
  </body>
</html>
