---
import RenderPost from '~/components/views/RenderPost.astro'
import { getFilteredPosts } from '~/utils/data'

/**
 * An English post with the Turkish interface around it, for readers on the
 * Turkish site (src/i18n.ts isMirrored): noindex, so the English page stays
 * the one search engines see. Posts published elsewhere have no page here.
 */
export async function getStaticPaths() {
  const posts = await getFilteredPosts('blog')
  return posts
    .filter((post) => !post.data.redirect)
    .map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
---

<RenderPost {post} mirror />
