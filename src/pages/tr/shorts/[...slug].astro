---
import RenderPost from '~/components/views/RenderPost.astro'
import { getFilteredPosts } from '~/utils/data'

/** A note with the Turkish interface around it: see src/pages/tr/blog/[...slug].astro. */
export async function getStaticPaths() {
  const posts = await getFilteredPosts('shorts')
  return posts
    .filter((post) => !post.data.redirect)
    .map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
---

<RenderPost {post} mirror />
