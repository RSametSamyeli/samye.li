---
import RenderPost from '~/components/views/RenderPost.astro'
import { getFilteredPosts } from '~/utils/data'

export async function getStaticPaths() {
  const posts = await getFilteredPosts('shorts')

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props

// A post published elsewhere (Medium) has no page here: its URL is a
// permanent redirect to the original, which stays the canonical copy.
if (post.data.redirect) return Astro.redirect(post.data.redirect, 301)
---

<RenderPost {post} />
